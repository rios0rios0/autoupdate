# >>> pipelines:begin
# Generated by `make gitignore` from rios0rios0/pipelines. Do not edit inside
# this block: it is rewritten in place, and CI fails when it is out of date.
#
# These are the files the pipeline itself writes into this working tree. The
# block sits first on purpose -- gitignore resolves last-match-wins, so any
# entry BELOW it, including a `!` negation, overrides what it says here.

# Files every pipeline writes into the working tree, whatever the language.
#
# `global/scripts/shared/cleanup.sh` creates REPORT_PATH before each tool runs and
# defaults it to `build/reports`; a language fragment that overrides REPORT_PATH
# ships its own entry for the directory it chose instead.
build/reports/

# CodeQL builds its database inside the project it is analysing
# (`global/scripts/tools/codeql/run.sh`) and removes it only on the happy path, so
# an interrupted or failing run leaves it behind.
.codeql-db/

# `makefiles/golang.mk` sets `REPORT_PATH ?= ./reports`, so Go projects collect tool
# reports here rather than under `build/`.
/reports/

# Written at the repository root by `global/scripts/languages/golang/test/run.sh`.
# The unit/integration pairs are the per-phase outputs; the unsuffixed files are the
# merged results the quality gate and the coverage report read.
/junit-unit.xml
/junit-integration.xml
/junit.xml
/unit_coverage.txt
/integration_coverage.txt
/coverage.out
/coverage.txt
/coverage.xml
/cobertura.xml
# <<< pipelines:end

bin
build
reports

# this space is for project generated files, DO NOT add personal or IDE files here
# try to use ~/.gitignore of your user for your workspace generated files
